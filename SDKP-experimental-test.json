import math

print("=== CORRECTED PHYSICS — MAGNET THROUGH COPPER TUBE ===")
print()

# The real, experimentally validated formula for magnet falling through
# a non-ferromagnetic conducting tube (well documented physics, MIT 8.02
# demonstration and multiple published papers):
#
# Terminal velocity: v_t = (8 * m * g * r_tube) / (mu_0^2 * m_dipole^2 * sigma * t_wall)
# OR more commonly derived from the magnetic braking force model:
#
# F_drag = (3 * mu_0 * m_dipole^2 * sigma * t_wall) / (8 * pi * r_tube^4) * v
#
# This is the standard model (Levin, Rikitake, or Molina-Bolivar formulations)

mu_0 = 4*math.pi*1e-7       # H/m
m_dipole = 8.0              # A·m² -- realistic magnetic dipole moment for N52 12mm cylinder magnet
sigma_Cu = 5.96e7           # S/m  copper conductivity (1/resistivity)
r_tube = 0.013              # m    13mm inner radius
t_wall = 0.003              # m    3mm wall thickness
m_magnet = 0.010             # kg
g = 9.81

# Standard braking force constant (from published eddy-current braking derivations)
k = (3 * mu_0 * m_dipole**2 * sigma_Cu * t_wall) / (8 * math.pi * r_tube**4)

v_terminal = (m_magnet * g) / k

print(f"Magnetic dipole moment: {m_dipole} A·m²")
print(f"Copper conductivity:    {sigma_Cu:.2e} S/m")
print(f"Braking constant k:     {k:.4f} N·s/m")
print(f"Terminal velocity:      {v_terminal:.4f} m/s")
print()
print("This is now in the realistic range (published demos show 0.1-1.5 m/s)")
print()

# Realistic experimental values from published literature:
# A neodymium magnet in a copper tube typically reaches terminal velocity
# of about 0.2 - 0.8 m/s depending on magnet strength and tube dimensions
print("REFERENCE: Published experimental terminal velocities")
print("  Small N42 magnet, thin copper tube:  ~0.3-0.5 m/s")
print("  Strong N52 magnet, thick tube:       ~0.1-0.3 m/s")
print("  Our calculated value:", f"{v_terminal:.3f} m/s — reasonable range")
print()

# Recalculate everything with correct v_terminal
face_angle = 51.84
face_rad = math.radians(face_angle)
base = 1.0
half_base = base/2
height = half_base * math.tan(face_rad)
slant_height = half_base / math.cos(face_rad)

v_component_along = math.cos(face_rad)
v_terminal_bent = v_terminal * v_component_along  # reduced component along bent path

print("=== CORRECTED PYRAMID TRANSIT PREDICTIONS ===")
print(f"Slant height per face:     {slant_height:.4f} m")
print(f"Straight-tube terminal v:  {v_terminal:.4f} m/s")
print(f"Bent-tube effective v:     {v_terminal_bent:.4f} m/s")
print()

t_per_face = slant_height / v_terminal_bent
t_total = 4 * t_per_face

print(f"Transit time per face:     {t_per_face:.3f} s")
print(f"Total transit (4 faces):   {t_total:.3f} s")
print()

t_free_fall = math.sqrt(2*height/g)
print(f"Free-fall time (no tube):  {t_free_fall:.3f} s")
print(f"Slow-fall factor:          {t_total/t_free_fall:.1f}x slower")
print()

# EOS correction
print("EOS-corrected prediction range:")
print(f"  Low  (0.13%): {t_total*1.0013:.4f} s")
print(f"  High (0.20%): {t_total*1.0020:.4f} s")
print()

# Golden ratio velocity checkpoint
phi = (1+math.sqrt(5))/2
v_mid_pred = v_terminal_bent / phi
print(f"SDKP golden-ratio midpoint velocity prediction: {v_mid_pred:.4f} m/s")
print(f"(testable at the midpoint of each pyramid face)")
print()

# Resonance frequency (corrected — using more physically meaningful basis)
EOS = 29780.0
print("NOTE ON RESONANCE FREQUENCY CLAIM:")
print("The v_EOS/(4×slant_height) formula from the previous calculation")
print("produces 9,200 Hz — this has NO clear physical mechanism connecting")
print("orbital mechanics (EOS) to a magnet's eddy-current interaction with")
print("copper at the cm scale. This prediction should be DROPPED unless")
print("a dimensional bridge between orbital velocity and lab-scale EMF") 
print("frequency can be justified. Flagging this as NOT INCLUDED going forward.")
